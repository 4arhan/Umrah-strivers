 {
  "h": "q5fmgh",
  "k": "A few minutes' walk from the Safa side of the Haram. Viewed from outside — it is not a place of worship; reflect, don't ritualise.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "zbhuad",
  "k": "A short ride north-west of the Haram; combine with the Seven Mosques.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "148g3jm",
  "k": "A short walk north of the Haram, near Jannat al-Mu'alla.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "wq6gcs",
  "k": "A small, easily-missed mosque near the Jamarat bridge; built in {1} AH.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "s93s18",
  "k": "A steep {1}–{2} min climb — go after Fajr, take water. Viewing from below also suffices; see the Revelation Exhibition at its foot.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "110mraw",
  "k": "A tougher climb than Hira; most pilgrims view it from the road on a ziyarah tour.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1b29k5f",
  "k": "A working date farm north of the city; a lesson in sadaqah jariyah.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1sr08u3",
  "k": "A {1}-minute walk south-west of Masjid an-Nabawi, beside Al Manakha.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "k4c4su",
  "k": "An evening stroll on the way to the airport. A cultural, not religious, visit.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "10ikg8o",
  "k": "Between Arafat and Mina on the pilgrim road.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "10csun4",
  "k": "Book in advance; sunset slots have the best views.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "m1wdtp",
  "k": "Combine Arafat, Muzdalifah & Mina in one half-day ziyarah taxi tour (agree the price first).",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "viva9n",
  "k": "Confirm it is open before going — it closed during the pandemic and may still be shut. The Exhibition of the Two Holy Mosques is about {1} km away in Umm al-Joud.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "nuat1n",
  "k": "Dates, cafés and evening buzz; a good meeting point for families.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1xtj8y2",
  "k": "Drive-through on a ziyarah tour; picture more than {1} million people sleeping here in one night.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "e7c1xk",
  "k": "Excellent with kids; guided tours available in English.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "qu7dvc",
  "k": "Give salam to the Prophet ﷺ and his two companions with calm and lowered voice.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1btdnmd",
  "k": "Give salam to the deceased; visiting hours are limited and entry is for men.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "beq0il",
  "k": "Handy between Uhud and Qiblatayn on the Red route.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1t1etun",
  "k": "Holds about {1}; it opens only in the Hajj season ({2} Dhul-Hijjah, Eid and the days of Tashriq) — outside Hajj you see it from the road.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "tj324e",
  "k": "In Umm al-Joud on the old Jeddah road, next to the Kiswah complex. Entry has traditionally been free — check hours and entry rules before going.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "11tgv3f",
  "k": "Landmarks inside: Hajar al-Aswad, Maqam Ibrahim, Hijr Isma'il, the Multazam & the Yamani corner.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1bb89l5",
  "k": "Masjid al-Fath on the hill is where the Prophet ﷺ prayed for victory. Minutes from Qiblatayn.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "mjc5ek",
  "k": "Near Quba; a quiet place to reflect on a seeker who crossed empires to find the truth.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "orxu7h",
  "k": "No longer standing — it was in the old al-Jawdariyyah quarter just north of the Haram and was demolished around {1}–{2} AH for the northern expansion of the Haram courtyards. Nothing remains to visit.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "kjif4w",
  "k": "Now crowned by a royal palace; visible from the Safa end of the mataf — no visit needed.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "aduyt3",
  "k": "Open after Fajr and Asr; entry for men. Give the sunnah salam to the people of the graves.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "jzexjt",
  "k": "Opens only on the day of Arafah; outside Hajj you view it from the road.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1sh5j5y",
  "k": "Quiet outside Hajj season — a moving drive-through with Quran {1} in mind.",
  "c": ".tip < .place-t < .place-h",
  "refs": [
   "quran:22:27"
  ]
 },
 {
  "h": "1r423u9",
  "k": "Requires a free timed permit from the Nusuk app — slots open only a short time ahead, so check Nusuk as your dates approach and book as soon as they open.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "gnzxc6",
  "k": "The Prophet ﷺ visited every Saturday, walking or riding (Bukhari {1}) — make wudu at your hotel and go at least once.",
  "c": ".tip < .place-t < .place-h",
  "refs": [
   "bukhari:1193"
  ]
 },
 {
  "h": "1kqwtgq",
  "k": "The multi-level bridge is an engineering marvel; visit outside Hajj to understand the layout before you ever come for Hajj.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1sha2kt",
  "k": "The museum is closed for restoration — check before you go. Hop-on hop-off stop.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1hubeam",
  "k": "The perfect alternative to the climb for the elderly and children. Book online; evening slots are cooler.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "ixhlim",
  "k": "The well itself is now beneath the mataf; chilled and room-temperature dispensers are on every floor. Face the qibla and make dua as you drink.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "zt94yz",
  "k": "Try the Hijr late at night after tawaf; pray your {1} rakahs anywhere behind the Maqam if the area is packed.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "17sub52",
  "k": "Try the local Ajwa dates and the famous Madinah bukhari rice.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "12rbnjh",
  "k": "Under {1} km north of Masjid Quba, near Quba Avenue — stop here if you walk to Quba.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1c3hxv6",
  "k": "Visit after Fajr before the heat; give salam at the martyrs' fence and climb the Archers' Hill to understand the battle.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1nd5aeo",
  "k": "Visits are by arrangement/tour; the exhibition explains every panel of calligraphy you see on the Kaaba.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "wwh3ap",
  "k": "Walk it at sunset; the bus brings you back. Hop-on hop-off stop.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "yeb6ev",
  "k": "Walk it slowly with salawat on your lips; no crowding, no raised voices.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1ppszis",
  "k": "Wheelchair lanes run down the middle; the green lights mark where men jog. Begin at Safa, finish at Marwah.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1hob2ud",
  "k": "Wonderful with children; tours in many languages.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "19541f6",
  "k": "You cross it on the way to Masjid al-Miqat — look out for it.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1h0mkme",
  "k": "{1} km south-west. Showers, wudu areas and ihram shops on site; most buses stop here on request. The Haramain train does not stop here — put on ihram before boarding and make the intention before the train passes the miqat.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "192oobg",
  "k": "{1} min from Baqi on Sitteen Street; pray two rakahs and make your own long dua.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "1fkc5mt",
  "k": "{1}–{2} min taxi; a Makkah Bus route also serves Tan'eem — check the Makkah Bus app for the current route and fare. Showers and ihram shops on site.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "19be1z3",
  "k": "~{1} h by road up the escarpment. Wadi Muharram on the way is a miqat if you return in ihram.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "thvhve",
  "k": "~{1} km north-east; far calmer than Tan'eem for a second Umrah.",
  "c": ".tip < .place-t < .place-h"
 },
 {
  "h": "8e7nhx",
  "k": "~{1} km west on the Jeddah road; the old mosque ruins stand beside the modern one.",
  "c": ".tip < .place-t < .place-h"
 },
